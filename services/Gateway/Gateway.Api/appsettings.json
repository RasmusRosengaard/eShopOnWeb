{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "publicapi": {
        "ClusterId": "publicapi",
        "Match": { "Path": "/api/{**rest}" }
      },
      "web": {
        "ClusterId": "web",
        "Match": { "Path": "{**catch-all}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      }
    },
    "Clusters": {
      "publicapi": {
        "Destinations": { "publicapi": { "Address": "https://localhost:5099/" } }
      },
      "web": {
        "Destinations": { "web": { "Address": "https://localhost:5001/" } }
      }
    }
  }
}